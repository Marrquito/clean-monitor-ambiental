# Copie para .env e ajuste. Não commite o arquivo .env com credenciais reais.

# PostgreSQL (usado pelo docker-compose e pelo backend executado localmente)
POSTGRES_DB=clean
POSTGRES_USER=clean
POSTGRES_PASSWORD=clean_dev_pw
# Porta do host para o PostgreSQL do container (5432 pode estar ocupada por outro serviço)
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgres://clean:clean_dev_pw@localhost:5433/clean?sslmode=disable

# Backend
HTTP_ADDR=:18080
APP_TIMEZONE=America/Sao_Paulo

# Ollama (executado no computador hospedeiro)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:2b
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PREDICT=220

# Ao usar docker-compose, o backend acessa o Ollama do host por este endereço
OLLAMA_URL_FROM_DOCKER=http://host.docker.internal:11434

# Simulador de sensores (substitui a ESP32 nesta primeira versão)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_BACKFILL_HOURS=24
